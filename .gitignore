# Binaires compilés (make build)
/bin/

# IDE
/.idea/

# OpenCode : dépendances locales uniquement (config versionnée)
/.opencode/node_modules/

# Artefacts Go (couverture, tests compilés)
*.out
*.test

# Baseline produite par la démo (make ci-demo) — dans un vrai projet, elle
# se versionne au contraire avec le code.
/.phperf-baseline.json
/.phperf-demo.json

# Base SQLite locale de triage (masquage) — état personnel, non versionnée.
/.phperf.db
