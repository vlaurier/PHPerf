{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PHPerf scoring config",
  "description": "Pondérations du scoreur PHPerf (v1). Toute clé absente garde sa valeur par défaut.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scoring"],
  "properties": {
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weights"],
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["effort"] },
            { "required": ["controllability"] }
          ],
          "properties": {
            "effort": {
              "$ref": "#/definitions/positiveWeights",
              "propertyNames": { "enum": ["low", "medium", "high"] }
            },
            "controllability": {
              "$ref": "#/definitions/positiveWeights",
              "propertyNames": { "enum": ["controllable", "partial", "none"] }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "positiveWeights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    }
  }
}
