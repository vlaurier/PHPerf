{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PHPerf Rules",
  "description": "Schema JSON pour valider les fichiers de regles YAML de PHPerf (format v1, supporte par internal/rules).",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["id", "name", "description", "severity", "effort", "controllability", "match"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "effort": { "enum": ["low", "medium", "high"] },
        "controllability": { "enum": ["controllable", "partial", "none"] },
        "match": { "$ref": "#/definitions/match" },
        "recommendation": { "type": "string" },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": "Ids de regles que cette regle rend sans objet sur le meme callee (resolution transitive, cycle interdit)."
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "function_pattern": { "type": "string" },
        "exclude_pattern": { "type": "string" },
        "call_count_threshold": { "type": "string", "pattern": "^>=[0-9]+$" },
        "caller_count_threshold": { "type": "string", "pattern": "^>=[0-9]+$" },
        "memory_per_call_threshold_mb": { "type": "string", "pattern": "^>=[0-9]+(\\.[0-9]+)?$" },
        "peak_memory_per_call_threshold_mb": { "type": "string", "pattern": "^>=[0-9]+(\\.[0-9]+)?$" },
        "inclusive_wt_ms_threshold": { "type": "string", "pattern": "^>=[0-9]+(\\.[0-9]+)?$" },
        "exclusive_wt_ms_threshold": { "type": "string", "pattern": "^>=[0-9]+(\\.[0-9]+)?$" },
        "time_share_percent_threshold": { "type": "string", "pattern": "^>=[0-9]+(\\.[0-9]+)?$" }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}
